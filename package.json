{
  "name": "insta-robot",
  "version": "1.0.2",
  "description": "Local Instagram private API client with FCA-compatible InstaBot adapter, cookie/AppState authentication and MQTT realtime messaging.",
  "displayName": "insta-robot ica by Tanvir143",
  "main": "dist/compat.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "examples",
    "LICENSE"
  ],
  "license": "MIT",
  "author": {
    "name": "Tanvir Ahmed",
    "url": "https://github.com/143tanvir"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/143tanvir/insta-robot.git"
  },
  "homepage": "https://github.com/143tanvir/insta-robot",
  "bugs": {
    "url": "https://github.com/143tanvir/insta-robot/issues"
  },
  "keywords": [
    "instagram",
    "instagram-api",
    "instagram-chat-api",
    "private-api",
    "mqtt",
    "fca",
    "fca-compatible",
    "instabot",
    "ica",
    "ig-chat-api",
    "instagram-bot",
    "instagram-mqtt",
    "tanvir143",
    "@tanvir143/ica"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "tslint -p tsconfig.json -c tslint.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "npm run build && node tests_run.js",
    "generate-interface": "ts-node ./tools/response-to-interface.ts",
    "generate-docs": "typedoc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@lifeomic/attempt": "^3.0.0",
    "@types/chance": "^1.0.2",
    "@types/request-promise": "^4.1.43",
    "bluebird": "^3.7.1",
    "chance": "^1.0.18",
    "class-transformer": "^0.3.1",
    "debug": "^4.1.1",
    "image-size": "^0.7.3",
    "json-bigint": "^1.0.0",
    "lodash": "^4.17.20",
    "luxon": "^1.12.1",
    "mqtt": "^5.14.1",
    "reflect-metadata": "^0.1.13",
    "request": "^2.88.0",
    "request-promise": "^4.2.4",
    "rxjs": "^6.5.2",
    "snakecase-keys": "^3.1.0",
    "tough-cookie": "^2.5.0",
    "ts-custom-error": "^2.2.2",
    "ts-xor": "^1.0.6",
    "url-regex-safe": "^3.0.0",
    "utility-types": "^3.10.0",
    "ws": "^8.18.2"
  },
  "peerDependencies": {
    "re2": "^1.17.2"
  },
  "peerDependenciesMeta": {
    "re2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bluebird": "^3.5.26",
    "@types/lodash": "^4.14.123",
    "@types/luxon": "^1.12.0",
    "@types/node": "^10.14.5",
    "@types/tough-cookie": "^2.3.5",
    "dotenv": "^6.2.0",
    "husky": "^1.3.0",
    "inquirer": "^1.1.2",
    "json-ts": "^1.6.4",
    "prettier": "^1.19.1",
    "pretty-quick": "^1.10.0",
    "rimraf": "^2.6.3",
    "ts-node": "^8.1.0",
    "tslint": "^5.16.0",
    "typedoc": "^0.22.11",
    "typedoc-plugin-markdown": "^3.11.14",
    "typescript": "^4.3.5"
  }
}
